{
  "kind": "collectionType",
  "collectionName": "news",
  "info": {
    "singularName": "news-entry",
    "pluralName": "news",
    "displayName": "最新消息",
    "description": "首頁最新訊息公告"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "newsDate": {
      "type": "date",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "description": {
      "type": "text",
      "required": false,
      "maxLength": 300
    },
    "externalLink": {
      "type": "string",
      "required": false
    }
  }
}
